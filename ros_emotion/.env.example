# Environment variables for the ROS Emotion system
# Copy this file to .env and fill in your values

# OpenAI API configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # You can use other models like gpt-4-turbo if preferred

# ROS Emotion configuration
ROS_EMOTION_CONFIG_PATH=src/ros_emotion/config/emotion_config.yaml
PERSONALITY_MODEL_TYPE=hybrid 